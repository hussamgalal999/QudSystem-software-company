# Copy to .env. Never commit real credentials or paste them into chat.
# Fallback OpenAI-compatible endpoint. Use a reachable remote or LAN URL in Docker.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=auto
# Leave blank to use the bundled FreeLLM gateway at http://freellm:4000/v1.
LLM_TIMEOUT_SECONDS=180
QUDRON_MAX_OUTPUT_TOKENS=1200
QUDRON_MAX_INPUT_CHARS=24000

# Optional model tiers: cheap routine work, balanced writing, high-reasoning reviews.
# Each tier falls back to the default endpoint above when left blank.
LLM_FAST_BASE_URL=
LLM_FAST_API_KEY=
LLM_FAST_MODEL=
LLM_BALANCED_BASE_URL=
LLM_BALANCED_API_KEY=
LLM_BALANCED_MODEL=
LLM_REASONING_BASE_URL=
LLM_REASONING_API_KEY=
LLM_REASONING_MODEL=

# FreeLLM is started by the default Compose stack; its local server key is generated
# and persisted in the freellm-state volume. You do not need to supply a key.
FREELM_SERVER_KEY=
# auto = use documented anonymous/free endpoints only when no provider keys are configured.
# Anonymous providers may log prompts; Qudron blocks sensitive task classes and PII-looking inputs.
# Set to 0 to require official provider keys only.
FREELM_KEYLESS=auto
# Optional official provider keys. Leave blank to use anonymous/free endpoints only.
GEMINI_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=
MIMO_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
MISTRAL_API_KEY=
NVIDIA_API_KEY=
CEREBRAS_API_KEY=
ZAI_API_KEY=
KILO_API_KEY=
COHERE_API_KEY=
# The default profile routes through FreeLLM. Provider discovery/failover is handled by that gateway.
# Anonymous/free routes are restricted by Qudron to public research and content drafts only.

# Optional exact model prices in USD per 1,000,000 tokens.
# Blank rates are accepted only for keyless anonymous FreeLLM routes; keyed/custom providers require exact rates.
# For direct OpenAI-compatible providers, configure LLM_BASE_URL, LLM_API_KEY, and LLM_MODEL together.
# The current Qudron worker speaks OpenAI Chat Completions; Anthropic Messages/Responses-specific APIs need an adapter.
LLM_INPUT_USD_PER_1M=
LLM_OUTPUT_USD_PER_1M=
LLM_FAST_INPUT_USD_PER_1M=
LLM_FAST_OUTPUT_USD_PER_1M=
LLM_BALANCED_INPUT_USD_PER_1M=
LLM_BALANCED_OUTPUT_USD_PER_1M=
LLM_REASONING_INPUT_USD_PER_1M=
LLM_REASONING_OUTPUT_USD_PER_1M=

# Model-spend safety: generic model calls fail closed unless a daily or monthly USD cap is set.
# Set QUDRON_REQUIRE_MODEL_BUDGET=false only for isolated development/testing, never for a hosted pilot.
QUDRON_REQUIRE_MODEL_BUDGET=true
# Configure at least one positive daily/monthly cap. Keyless free routes use zero provider-price estimates;
# all keyed/custom routes require exact input/output rates before they can be called.
# Provider-side hard caps are also required; local estimates cannot guarantee the provider's invoice ceiling.
QUDRON_DAILY_MODEL_BUDGET_USD=0.25
QUDRON_MONTHLY_MODEL_BUDGET_USD=
# Mandatory per-order USD model cap before a CVPen creation job is allowed to call a model.
QUDRON_CVPEN_JOB_BUDGET_USD=

# Optional owner command/notification channel. Enable with --profile telegram.
# Create a Telegram bot via BotFather; never share the token in chat or Git.
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric Telegram chat IDs allowed to issue commands (owner only).
TELEGRAM_OWNER_CHAT_IDS=
TELEGRAM_HTTP_TIMEOUT=15
QUDRON_INTERNAL_URL=http://qudron:8765

# Protect POST /jobs, POST /jobs/batch, /mcp, and GET /jobs/{id}. Leave blank to let the runtime create a private token in /app/data/api_token.
QUDRON_API_TOKEN=
QUDRON_API_TOKEN_FILE=/run/qudron-auth/api_token
QUDRON_MAX_API_BATCH_SIZE=100
QUDRON_MAX_PENDING_JOBS=100000
# Never default a paid/keyed provider to zero-rate accounting.
QUDRON_ALLOW_ZERO_RATE_PROVIDER=false

# HMAC key for consented contact fingerprints in the internal commercial ledger.
# Generate at least 32 random bytes; keep it private and stable for the ledger lifetime.
QUDRON_CONTACT_HMAC_KEY=replace-with-at-least-32-random-characters

# Each task plans the complete configured specialist team by default; this is a
# role-assignment guard, not a count of running agent instances or model sessions.
QUDRON_SWARM_ENABLED=true
QUDRON_MAX_ROLE_ASSIGNMENTS_PER_TASK=10000
# Per-task review fan-out; the shared provider-call gate below remains authoritative.
QUDRON_MAX_PARALLEL_REVIEWS=16
# Shared SQLite-backed global cap across all queue workers (prevents CVPen swarms multiplying provider calls).
QUDRON_MAX_CONCURRENT_MODEL_CALLS=16
QUDRON_MODEL_CALL_SLOT_TIMEOUT_SECONDS=120
QUDRON_AGENT_REGISTRY_PATH=/app/agent_registry.json

QUDRON_WORKERS=8
QUDRON_POLL_SECONDS=5
QUDRON_MAX_ATTEMPTS=5
QUDRON_LOCK_SECONDS=900
QUDRON_HEALTH_PORT=8765
QUDRON_LOG_LEVEL=INFO

# Optional read-only GitHub inventory sync; token needs read-only Metadata access to intended repos.
GITHUB_OWNER=
GITHUB_TOKEN=
QUDRON_GITHUB_INVENTORY_PATH=/app/data/github_inventory.json
# Weekly read-only GitHub mining batch size (1-200); requires the read-only token above.
QUDRON_GITHUB_MINE_MAX_REPOSITORIES=50
# Optional Metricool official API integration (requires Advanced or Custom plan API access).
METRICOOL_API_TOKEN=
METRICOOL_USER_ID=
METRICOOL_BLOG_ID=
METRICOOL_TIMEZONE=Africa/Cairo

# Optional multimodal vision adapter; endpoint must support image_url content.
QUDRON_IMAGE_ROOT=/app/inbox/images
QUDRON_VISION_MAX_IMAGE_BYTES=8388608

# Optional provider profiles (uncomment only after provider keys and hard spend caps are configured).
# FAST — DeepSeek V4.1 Flash (conservative peak rates, USD per 1M tokens).
# LLM_FAST_BASE_URL=https://api.deepseek.com
# LLM_FAST_MODEL=deepseek-flash
# LLM_FAST_API_KEY=
# LLM_FAST_INPUT_USD_PER_1M=0.30
# LLM_FAST_OUTPUT_USD_PER_1M=1.20
# BALANCED — Xiaomi MiMo V2.6 Pro.
# LLM_BALANCED_BASE_URL=https://api.xiaomimimo.com/v1
# LLM_BALANCED_MODEL=mimo-v2.6-pro
# LLM_BALANCED_API_KEY=
# LLM_BALANCED_INPUT_USD_PER_1M=0.435
# LLM_BALANCED_OUTPUT_USD_PER_1M=0.87
# REASONING — Meta Muse Wonder via OpenRouter.
# LLM_REASONING_BASE_URL=https://openrouter.ai/api/v1
# LLM_REASONING_MODEL=meta/muse-wonder
# LLM_REASONING_API_KEY=
# LLM_REASONING_INPUT_USD_PER_1M=4.00
# LLM_REASONING_OUTPUT_USD_PER_1M=20.00

# Provider continuity: read-only model-list probes + persistent circuit breakers.
# Profiles may use only the data classes explicitly approved here. Keep confidential
# out of hosted routes until the provider's data terms and owner approval are checked.
QUDRON_PROVIDER_DATA_CLASSES=public,internal
QUDRON_PROVIDER_HEALTH_INTERVAL_SECONDS=300
QUDRON_PROVIDER_PROBE_TIMEOUT_SECONDS=5
# Optional owner-approved fallback chain. Never put API key values in this JSON;
# reference host secret names instead. Each paid route needs exact current prices.
# Free routes require verified_free=true after checking the account's actual entitlement.
# DeepSeek model ID deepseek-flash currently maps to V4.1-Flash-1017.
# QUDRON_PROVIDER_ROUTES_JSON='[{"route_id":"deepseek-flash-balanced","provider_id":"deepseek","profile":"balanced","base_url":"https://api.deepseek.com","model":"deepseek-flash","api_key_env":"DEEPSEEK_API_KEY","enabled":true,"owner_approved":true,"protocol":"openai_chat_completions","price_class":"paid","input_usd_per_1m":0.30,"output_usd_per_1m":1.20,"accepted_data_classes":["public","internal"],"priority":10}]'

# Optional official DeepSeek live web search/fetch. Disabled until daily call cap is configured.
DEEPSEEK_API_KEY=
QUDRON_WEB_SEARCH_ENABLED=false
QUDRON_WEB_SEARCH_MAX_DAILY_CALLS=0
QUDRON_WEB_SEARCH_DB=/app/data/web_search_usage.sqlite3

# Enable read-only Metricool calendar and analytics sync for social research jobs.
QUDRON_METRICOOL_SYNC_ENABLED=false


# OpenDots user-facing AI coworker workspace (optional Compose profile: opendots).
# OpenDots is a separate interface that controls Qudron through an auto-registered MCP connection.
# A dedicated Qudron Commander Dot is created in a Qudron Command Room Space.
# Conversations remain in setup mode until a CopilotKit Intelligence project is connected.
OPENDOTS_OWNER_ID=qudron-owner
OPENDOTS_APP_ORIGIN=http://localhost:4310
OPENDOTS_CPK_INTELLIGENCE_API_KEY=
OPENDOTS_CPK_TELEMETRY_ID=
OPENDOTS_INTELLIGENCE_API_KEY=
OPENDOTS_INTELLIGENCE_API_URL=
OPENDOTS_INTELLIGENCE_GATEWAY_WS_URL=
OPENDOTS_OPENAI_API_KEY=
OPENDOTS_OPENAI_BASE_URL=
OPENDOTS_OPENAI_MODEL=auto
OPENDOTS_ENABLE_KEYLESS_MODEL=false
OPENDOTS_WEB_SEARCH_PROVIDER=parallel
OPENDOTS_PARALLEL_API_KEY=
OPENDOTS_VOICE_API_KEY=
OPENDOTS_VOICE_MODEL=gpt-realtime-2.1
OPENDOTS_VOICE_NAME=marin

# Optional OpenBot per-Dot computers. Prepare tokens + Docker network with:
# python3 scripts/prepare_opendots_computers.py .env
COMPUTER_SUPERVISOR_TOKEN=
COMPUTER_TOKEN=
COMPUTER_NAMESPACE=qudron
COMPUTER_MEMORY_BYTES=2147483648
COMPUTER_RUNTIME=
ENGINE_SOCKET=/var/run/docker.sock
