# Copy to .env. Never commit real credentials or paste them into chat.
# Fallback OpenAI-compatible endpoint. Use a reachable remote or LAN URL in Docker.
LLM_BASE_URL=http://127.0.0.1:1234/v1
LLM_API_KEY=
LLM_MODEL=your-local-model-name
LLM_TIMEOUT_SECONDS=180
QUDRON_MAX_OUTPUT_TOKENS=1200
QUDRON_MAX_INPUT_CHARS=24000

# Optional model tiers: cheap routine work, balanced writing, high-reasoning reviews.
# Each tier falls back to the default endpoint above when left blank.
LLM_FAST_BASE_URL=
LLM_FAST_API_KEY=
LLM_FAST_MODEL=
LLM_BALANCED_BASE_URL=
LLM_BALANCED_API_KEY=
LLM_BALANCED_MODEL=
LLM_REASONING_BASE_URL=
LLM_REASONING_API_KEY=
LLM_REASONING_MODEL=

# Optional FreeLLM sidecar. Disabled by default; enable Compose profile "free-ai".
# Generate a unique random value (32+ bytes) and keep it private.
FREELM_SERVER_KEY=replace-with-a-long-random-secret
# auto = use documented anonymous endpoints only when no provider keys are configured.
# Set to 0 when using official provider keys only; anonymous endpoints may log prompts.
FREELM_KEYLESS=auto
# Optional official provider keys. Leave blank if not configured.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
MISTRAL_API_KEY=
NVIDIA_API_KEY=
CEREBRAS_API_KEY=
ZAI_API_KEY=
KILO_API_KEY=
COHERE_API_KEY=
# To route only the FAST profile through FreeLLM, explicitly set:
# LLM_FAST_BASE_URL=http://freellm:4000/v1
# LLM_FAST_MODEL=auto
# The Compose file supplies LLM_FAST_API_KEY from FREELM_SERVER_KEY.

# Optional exact model prices in USD per 1,000,000 tokens.
# Set provider/model-specific rates for enforceable spend budgets; blank values still track token counts.
LLM_INPUT_USD_PER_1M=
LLM_OUTPUT_USD_PER_1M=
LLM_FAST_INPUT_USD_PER_1M=
LLM_FAST_OUTPUT_USD_PER_1M=
LLM_BALANCED_INPUT_USD_PER_1M=
LLM_BALANCED_OUTPUT_USD_PER_1M=
LLM_REASONING_INPUT_USD_PER_1M=
LLM_REASONING_OUTPUT_USD_PER_1M=

# Model-spend safety: generic model calls fail closed unless a daily or monthly USD cap is set.
# Set QUDRON_REQUIRE_MODEL_BUDGET=false only for isolated development/testing, never for a hosted pilot.
QUDRON_REQUIRE_MODEL_BUDGET=true
# Configure at least one positive daily/monthly cap AND exact input/output prices for every enabled profile.
# Provider-side hard caps are also required; local estimates cannot guarantee the provider's invoice ceiling.
QUDRON_DAILY_MODEL_BUDGET_USD=
QUDRON_MONTHLY_MODEL_BUDGET_USD=
# Mandatory per-order USD model cap before a CVPen creation job is allowed to call a model.
QUDRON_CVPEN_JOB_BUDGET_USD=

# Optional owner command/notification channel. Enable with --profile telegram.
# Create a Telegram bot via BotFather; never share the token in chat or Git.
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric Telegram chat IDs allowed to issue commands (owner only).
TELEGRAM_OWNER_CHAT_IDS=
TELEGRAM_HTTP_TIMEOUT=15
QUDRON_INTERNAL_URL=http://qudron:8765

# Protect POST /jobs and GET /jobs/{id}. Use a long random secret; never commit the real value.
QUDRON_API_TOKEN=replace-with-a-long-random-secret

# HMAC key for consented contact fingerprints in the internal commercial ledger.
# Generate at least 32 random bytes; keep it private and stable for the ledger lifetime.
QUDRON_CONTACT_HMAC_KEY=replace-with-at-least-32-random-characters

# Swarm size is bounded per task to cap cost and latency. 30+ specialists are registered;
# each job invokes at most this many sequential specialist stages.
QUDRON_SWARM_ENABLED=true
QUDRON_MAX_SWARM_AGENTS=5
# CVPen paid CV creation uses a separate 10-role swarm cap; routine tasks remain capped at five.
QUDRON_MAX_CVPEN_AGENTS=10
QUDRON_MAX_PARALLEL_REVIEWS=8
# Shared SQLite-backed global cap across all queue workers (prevents CVPen swarms multiplying provider calls).
QUDRON_MAX_CONCURRENT_MODEL_CALLS=8
QUDRON_MODEL_CALL_SLOT_TIMEOUT_SECONDS=120
QUDRON_AGENT_REGISTRY_PATH=/app/agent_registry.json

QUDRON_WORKERS=4
QUDRON_POLL_SECONDS=5
QUDRON_MAX_ATTEMPTS=5
QUDRON_LOCK_SECONDS=900
QUDRON_HEALTH_PORT=8765
QUDRON_LOG_LEVEL=INFO

# Optional read-only GitHub inventory sync; token needs read-only Metadata access to intended repos.
GITHUB_OWNER=
GITHUB_TOKEN=
QUDRON_GITHUB_INVENTORY_PATH=/app/data/github_inventory.json
# Optional Metricool official API integration (requires Advanced or Custom plan API access).
METRICOOL_API_TOKEN=
METRICOOL_USER_ID=
METRICOOL_BLOG_ID=
METRICOOL_TIMEZONE=Africa/Cairo

# Optional multimodal vision adapter; endpoint must support image_url content.
QUDRON_IMAGE_ROOT=/app/inbox/images
QUDRON_VISION_MAX_IMAGE_BYTES=8388608

# Optional provider profiles (uncomment only after provider keys and hard spend caps are configured).
# FAST — DeepSeek V4.1 Flash (conservative peak rates, USD per 1M tokens).
# LLM_FAST_BASE_URL=https://api.deepseek.com
# LLM_FAST_MODEL=deepseek-flash
# LLM_FAST_API_KEY=
# LLM_FAST_INPUT_USD_PER_1M=0.30
# LLM_FAST_OUTPUT_USD_PER_1M=1.20
# BALANCED — Xiaomi MiMo V2.6 Pro.
# LLM_BALANCED_BASE_URL=https://api.xiaomimimo.com/v1
# LLM_BALANCED_MODEL=mimo-v2.6-pro
# LLM_BALANCED_API_KEY=
# LLM_BALANCED_INPUT_USD_PER_1M=0.435
# LLM_BALANCED_OUTPUT_USD_PER_1M=0.87
# REASONING — Meta Muse Wonder via OpenRouter.
# LLM_REASONING_BASE_URL=https://openrouter.ai/api/v1
# LLM_REASONING_MODEL=meta/muse-wonder
# LLM_REASONING_API_KEY=
# LLM_REASONING_INPUT_USD_PER_1M=4.00
# LLM_REASONING_OUTPUT_USD_PER_1M=20.00
