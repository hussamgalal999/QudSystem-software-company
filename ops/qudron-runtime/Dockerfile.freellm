FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
RUN python -m pip install --no-cache-dir "freelm==0.5.2"
WORKDIR /app
COPY start_freellm.sh /usr/local/bin/start_freellm
RUN chmod 0755 /usr/local/bin/start_freellm
EXPOSE 4000
ENTRYPOINT ["/usr/local/bin/start_freellm"]
