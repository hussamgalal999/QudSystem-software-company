{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qudsystem.ltd/schemas/qudron-engineering-task-v1.schema.json",
  "title": "Qudron Engineering Worker Task Manifest",
  "description": "A bounded wave of independent repository engineering tasks. This manifest does not authorize deployment, merging, secret access, or external side effects.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "base_ref", "tasks"],
  "properties": {
    "version": { "const": 1 },
    "base_ref": { "type": "string", "minLength": 1, "maxLength": 200 },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/task" }
    }
  },
  "$defs": {
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "title", "objective", "allowed_paths", "acceptance_criteria"],
      "properties": {
        "task_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,39}$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 160 },
        "objective": { "type": "string", "minLength": 1, "maxLength": 5000 },
        "allowed_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)\\.(?:/|$)).+$"
          }
        },
        "deny_paths": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "acceptance_criteria": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
        }
      }
    }
  }
}
